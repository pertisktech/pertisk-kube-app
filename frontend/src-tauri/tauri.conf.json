{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTKublet",
  "version": "0.1.0",
  "identifier": "com.pertisk.ptkublet",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 3000 --strictPort",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PTKublet",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "bundle-resources/pertisk-kube-backend": "pertisk-kube-backend"
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
